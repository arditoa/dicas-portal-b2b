{
  "expo": {
    "name": "Dicas LGBT+",
    "slug": "dicas-lgbt",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "scheme": "dicaslgbt",
    "ios": {
      "bundleIdentifier": "com.dicaslgbt.app",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização só enquanto você usa o app, para mostrar a cidade onde você está e os locais, eventos e roteiros LGBT+ por perto. Ela não é mostrada para outras pessoas.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dicaslgbt.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0B0E"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#E1306C"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização só enquanto você usa o app, para mostrar a cidade onde você está e os locais, eventos e roteiros LGBT+ por perto. Ela não é mostrada para outras pessoas."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#111217"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c72d7cda-e9b2-4390-bd03-43d1befcbaec"
      }
    }
  }
}
